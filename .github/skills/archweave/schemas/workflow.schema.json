{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archweave/workflow.schema.json",
  "title": "ArchWeave workflow diagram plan v0.1 (swimlanes, gates, hand-offs)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "lanes", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "workflow" },
    "meta": { "$ref": "common.schema.json#/$defs/meta" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "owner": { "$ref": "common.schema.json#/$defs/owner" },
          "label": { "$ref": "common.schema.json#/$defs/shortText" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "lane", "kind"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "$ref": "common.schema.json#/$defs/shortText" },
          "sublabel": { "type": "string", "maxLength": 60 },
          "lane": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["start", "step", "gate", "handoff", "automated", "end"] },
          "icon": { "type": "string", "pattern": "^i-[a-z0-9]+$" },
          "removed_by_golden_path": { "type": "boolean" },
          "evidence": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "maxLength": 50 },
          "condition": { "enum": ["yes", "no", "pass", "fail", "always"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/note" } },
    "legend": { "$ref": "common.schema.json#/$defs/legend" }
  }
}
