  "messages": [
    { "id": "m1", "from": "user", "to": "entra", "label": "sign-in (MSAL), request token for the API app registration", "kind": "sync" },
    { "id": "m2", "from": "entra", "to": "user", "label": "JWT with app roles", "kind": "return" },
    { "id": "m3", "from": "user", "to": "tm", "label": "resolve api-internal.example.com", "kind": "sync" },
    { "id": "m4", "from": "tm", "to": "user", "label": "regional APIM address (health-based steering)", "kind": "return" },
    { "id": "m5", "from": "user", "to": "apim", "label": "GET /v1/... · Bearer JWT · x-correlation-id", "kind": "sync", "activates": true },
    { "id": "m6", "from": "apim", "to": "entra", "label": "validate-jwt (cached JWKS), rate-limit by subscription", "kind": "sync", "note": "Policy is inherited from the hub product; workload sets only its backend and scopes" },
    { "id": "m7", "from": "apim", "to": "app", "label": "forward over private endpoint, correlation id preserved", "kind": "sync", "activates": true },
