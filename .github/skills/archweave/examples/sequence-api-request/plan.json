    { "id": "apim", "label": "Internal APIM", "sublabel": "shared · hub", "color": "grey", "icon": "i-apim", "owner": "Platform Engineering" },
    { "id": "app", "label": "App Service", "sublabel": "spoke · PE inbound", "color": "blue", "icon": "i-app", "owner": "App team" },
