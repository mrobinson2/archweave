    { "id": "m9", "from": "app", "to": "sql", "label": "query · Entra token · TDS 1433 over PE", "kind": "sync" },
    { "id": "m10", "from": "sql", "to": "app", "label": "rows", "kind": "return" },
    { "id": "m11", "from": "app", "to": "law", "label": "log event: app_id, env, tier, correlation_id, latency", "kind": "async" },
    { "id": "m12", "from": "app", "to": "apim", "label": "200 JSON", "kind": "return" },
    { "id": "m13", "from": "apim", "to": "user", "label": "200 · rate-limit headers · correlation id echoed", "kind": "return" }
  ],
  "groups": [
    { "id": "g-policy", "kind": "opt", "label": "APIM inbound policy (hub owned)", "from_message": "m5", "to_message": "m7" }
